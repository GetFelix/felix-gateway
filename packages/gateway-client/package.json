{
  "name": "felix-gateway-client",
  "version": "0.2.0",
  "description": "The browser client for felix-gateway, and an in-memory fake of it for tests",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GetFelix/felix-gateway.git",
    "directory": "packages/gateway-client"
  },
  "homepage": "https://github.com/GetFelix/felix-gateway#readme",
  "bugs": "https://github.com/GetFelix/felix-gateway/issues",
  "keywords": [
    "felix",
    "websocket",
    "gateway",
    "pubsub"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fake": {
      "types": "./dist/fake.d.ts",
      "default": "./dist/fake.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^5.0.2"
  }
}
